# Convex deployment URL (from `npx convex dashboard` or `convex dev` output)
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex HTTP actions URL (same deployment, .convex.site subdomain)
PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Your Astro app URL (for Better Auth CSRF and redirect validation)
SITE_URL=http://localhost:4321

# Random secret for Better Auth session signing (run: openssl rand -base64 32)
BETTER_AUTH_SECRET=your-secret-here

# Session refresh cadence in seconds. Must mirror the Convex deployment value
# (npx convex env set SESSION_UPDATE_AGE <seconds>) — the client polls
# get-session at this interval to keep an open tab's session alive.
# Defaults to 86400 (24h). Set both to 10 when testing with SESSION_EXPIRES_IN=30.
#SESSION_UPDATE_AGE=86400
